{{- /*gotype: github.com/antonmedv/gitmal/pkg/templates.HeaderParams*/ -}}
{{ define "header" }}


    <div class="header-container">
		<style>
			.branch-dropdown {
					position: relative;
					display: inline-block;
					margin-right: 10px;
			}

			.branch-dropdown-btn {
					display: flex;
					align-items: center;
					gap: 6px;
					width: fit-content;
					padding: 5px 12px;
					border: 1px solid var(--c-border);
					border-radius: var(--border-radius);
					background: var(--c-bg-elv);
					color: var(--c-text-1);
					font-family: var(--font-family);
					font-size: 14px;
					font-weight: 500;
					cursor: pointer;
					list-style: none;
			}

			.branch-dropdown-btn::-webkit-details-marker {
					display: none;
			}

			.branch-dropdown-btn:hover {
					background: var(--c-gray-soft);
					border-color: var(--c-brand-2);
			}

			.branch-dropdown-caret {
					color: var(--c-text-3);
					transition: transform 0.15s ease;
			}

			.branch-dropdown[open] .branch-dropdown-caret {
					transform: rotate(180deg);
			}

			.branch-dropdown-list {
					position: absolute;
					top: calc(100% + 6px);
					left: 0;
					width: max-content;
					min-width: 180px;
					max-height: 300px;
					overflow-y: auto;
					margin: 0;
					padding: 6px 0;
					list-style: none;
					background: var(--c-bg-elv);
					border: 1px solid var(--c-border);
					border-radius: var(--border-radius);
					box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
					z-index: 50;
			}

			.branch-dropdown-list li a {
					display: flex;
					align-items: center;
					gap: 8px;
					padding: 6px 12px;
					font-family: var(--font-family);
					font-size: 13px;
					text-decoration: none;
					color: var(--c-text-1);
			}

			.branch-dropdown-list li a:hover {
					background: var(--c-gray-soft);
					color: var(--c-brand-1);
			}

			.branch-default-badge {
					font-size: 11px;
					padding: 1px 6px;
					border: 1px solid var(--c-border);
					border-radius: 10px;
					color: var(--c-text-3);
			}
			</style>
        <header>
							{{ if .Ref }}
                {{ if .Branches }}
                <details class="branch-dropdown" data-current-ref-dir="{{ .CurrentRefDir }}">
                    <summary class="branch-dropdown-btn">
												<svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-git-branch" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align: text-bottom;">
													<path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z">
													</path>
												</svg>
                        <span>{{ .Ref }}</span>
                        <svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-triangle-down" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="m4.427 7.427 3.396 3.396a.25.25 0 0 0 .354 0l3.396-3.396A.25.25 0 0 0 11.396 7H4.604a.25.25 0 0 0-.177.427Z">
												</path></svg>                   
											</summary>
                    <ul class="branch-dropdown-list">
                        {{ range .Branches }}
                        <li>
                            <a href="{{ $.RootHref }}{{ .Href }}" data-branch-dir="{{ .DirName }}">
                                {{ .Name }}
                                {{ if .IsDefault }}<span class="branch-default-badge">default</span>{{ end }}
                            </a>
                        </li>
                        {{ end }}
                    </ul>
                </details>
                {{ else }}
                <div class="header-ref" aria-label="Ref">{{ .Ref }}</div>
                {{ end }}
            {{ end }}

            {{ if .Header }}
                <h1 class="title">{{ .Header }}</h1>
            {{ else if .Breadcrumbs }}
                {{ if gt (len .Breadcrumbs) 1 }}
                <nav class="breadcrumbs" aria-label="Breadcrumbs">
                    {{ range $i, $b := .Breadcrumbs }}
                        {{ if gt $i 0 }}
                            <div>/</div>
                        {{ end }}
                        {{ if $b.Href }}
                            <a href="{{$b.Href}}">{{$b.Name}}</a>
                        {{ else }}
                            <h1>{{$b.Name}}</h1>
                            {{ if $b.IsDir}}
                                <div>/</div>
                            {{ end}}
                        {{ end }}
                    {{ end }}
                </nav>
                {{ end }}
            {{ end }}

            <button class="goto-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                <svg aria-hidden="true" focusable="false" width="16" height="16">
                    <use xlink:href="#arrow-top"></use>
                </svg>
                Top
            </button>

						<script>
				document.querySelector('.branch-dropdown')?.addEventListener('click', (e) => {
				const a = e.target.closest('a[data-branch-dir]');
				if (!a) return;

				const current = e.currentTarget.dataset.currentRefDir;
				const next = a.dataset.branchDir;
				if (next === current) return;

				const path = location.pathname;
				for (const section of ['blob', 'commits']) {
					const needle = `/${section}/${current}/`;
					const i = path.indexOf(needle);
					if (i !== -1) {
					e.preventDefault();
					location.href = path.slice(0, i) + `/${section}/${next}/` + path.slice(i + needle.length);
					return;
					}
				}
				// else: default href (branch home)
				});
			</script>

        </header>
    </div>
{{ end }}
